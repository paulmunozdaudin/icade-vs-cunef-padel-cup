# Copia este archivo a .env.local (en local) o crea estas variables en
# Vercel > Project > Settings > Environment Variables.

# Clave secreta de Stripe (Dashboard > Developers > API keys).
# Usa sk_test_... para pruebas y sk_live_... para vender de verdad.
# Sin esta variable la web NO cobra: avisa de que el pago aún no está activo.
STRIPE_SECRET_KEY=

# URL pública de la web, sin barra final (ej. https://icade-vs-cunef.vercel.app).
# Opcional en Vercel: si no se define se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=

# Token largo y aleatorio para consultar parejas y cruces en /api/admin/pairs.
ADMIN_TOKEN=
